# DigitalOcean API token. A read-only token is enough.
DIGITALOCEAN_TOKEN=

# Address the metrics endpoint binds to.
WEB_LISTEN_ADDRESS=:9212

# Log level: debug, info, warn, error. Format: logfmt or json.
LOG_LEVEL=info
LOG_FORMAT=logfmt

# Collector switches.
COLLECTOR_ACCOUNT=true
COLLECTOR_ACCOUNT_INTERVAL=5m
