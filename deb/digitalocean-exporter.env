# Configuration of digitalocean-exporter. Every flag has an environment
# variable; systemd reads this file, so comments start at the beginning of a
# line and values are never quoted.

# DigitalOcean API token. A read-only token is enough.
DIGITALOCEAN_TOKEN=

# Or keep the token in a file of its own and leave the variable above empty.
#DIGITALOCEAN_TOKEN_FILE=/etc/digitalocean-exporter/token

# Address the metrics endpoint binds to.
WEB_LISTEN_ADDRESS=:9212

# Log level: debug, info, warn, error. Format: logfmt or json.
LOG_LEVEL=info
LOG_FORMAT=logfmt

# Timeout of a single collector refresh.
#DO_TIMEOUT=30s

# ── Collectors ───────────────────────────────────────────────────────────────
#
# Here a collector is switched off with the value false; the flag form is the
# negated --no-collector.<name> instead, and --collector.<name>=false is a parse
# error. Every collector also takes COLLECTOR_<NAME>_INTERVAL, which defaults to
# 5m and is only worth setting when you want a slower refresh:
#
#COLLECTOR_DROPLETS_INTERVAL=10m

# On by default: one to three API requests each per refresh, on any account.
COLLECTOR_ACCOUNT=true
# The balance collector needs a billing-scoped token. Set it to false if yours
# has none, rather than watching it fail every five minutes.
COLLECTOR_BALANCE=true
COLLECTOR_REGISTRY=true
COLLECTOR_LIMITS=true
COLLECTOR_DROPLETS=true
COLLECTOR_DATABASES=true
COLLECTOR_KUBERNETES=true
COLLECTOR_VOLUMES=true
COLLECTOR_LOADBALANCERS=true
COLLECTOR_CDN=true
COLLECTOR_DOMAINS=true

# Off by default, though they cost no more than the collectors above: a
# firewall ruleset changes when somebody deploys and a certificate when it is
# renewed, so scraping them is a deliberate choice.
#COLLECTOR_FIREWALLS=true
#COLLECTOR_CERTIFICATES=true

# Off by default because it takes a Spaces key pair rather than the API token.
# Leave the bucket list empty to discover buckets, which needs a full-access
# key; naming buckets works with a restricted one. A bucket may carry its own
# region as name@region.
#COLLECTOR_SPACES=true
#COLLECTOR_SPACES_BUCKET=my-bucket
#COLLECTOR_SPACES_CONCURRENCY=4
#COLLECTOR_SPACES_TIMEOUT=2m
#SPACES_REGION=fra1
#DIGITALOCEAN_SPACES_KEY=
#DIGITALOCEAN_SPACES_SECRET=
#DIGITALOCEAN_SPACES_KEY_FILE=/etc/digitalocean-exporter/spaces-key
#DIGITALOCEAN_SPACES_SECRET_FILE=/etc/digitalocean-exporter/spaces-secret

# Off by default because of what they cost: the monitoring API answers one
# metric of one resource per request, so these grow with the size of the
# account — 10 requests per droplet and 7 per load balancer, every refresh.
#COLLECTOR_DROPLETMETRICS=true
#COLLECTOR_DROPLETMETRICS_CONCURRENCY=4
#COLLECTOR_DROPLETMETRICS_TIMEOUT=2m
#COLLECTOR_LOADBALANCERMETRICS=true
#COLLECTOR_LOADBALANCERMETRICS_CONCURRENCY=4
#COLLECTOR_LOADBALANCERMETRICS_TIMEOUT=2m
