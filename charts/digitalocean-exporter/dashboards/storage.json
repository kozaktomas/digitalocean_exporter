    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Volumes with no droplet attached. DigitalOcean bills a volume for as long as it exists, attached or not, so these are usually leftovers from deleted droplets or released PersistentVolumeClaims.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(max by (id) (digitalocean_volume_droplets{job=~\"$job\"}) == 0) or vector(0)",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Volumes",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Volumes attached to nothing",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
