    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Storage against what the subscription tier includes. Going over does not stop pushes -- DigitalOcean charges the overage -- so this is a billing warning, not an outage warning. DigitalOcean recomputes the usage figure periodically, so it lags a push. Needs --collector.registry.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 6,
      "options": {
        "displayMode": "lcd",
        "minVizHeight": 12,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (registry) (digitalocean_registry_storage_usage_bytes{job=~\"$job\"} / digitalocean_registry_storage_included_bytes{job=~\"$job\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{registry}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Registry storage used",
      "type": "bargauge"
    },
