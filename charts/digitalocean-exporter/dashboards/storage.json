        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (id, name, region) (digitalocean_volume_size_bytes{job=~\"$job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (id) (digitalocean_volume_droplets{job=~\"$job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Volumes",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "includeByName": {},
            "indexByName": {
              "Value #A": 1,
              "Value #B": 2,
              "id": 4,
              "name": 0,
              "region": 3
            },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
