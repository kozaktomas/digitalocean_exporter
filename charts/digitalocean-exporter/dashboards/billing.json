      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (id, name, region, size) (digitalocean_droplet_price_monthly{job=~\"$job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Droplets by monthly price",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "includeByName": {},
            "indexByName": {
              "Value #A": 4,
              "id": 3,
              "name": 0,
              "region": 1,
              "size": 2
            },
            "renameByName": {
              "Value #A": "Monthly price"
            }
          }
        }
      ],
      "type": "table"
    },
