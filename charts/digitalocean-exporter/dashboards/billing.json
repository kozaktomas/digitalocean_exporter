    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How old the balance DigitalOcean reports is. It is generated periodically rather than on request, so a stale figure read as current is a wrong answer rather than a missing one. Needs --collector.balance, and a token with the billing scope. A token that reads every resource still gets 403 here, which leaves this panel empty while digitalocean_exporter_collector_success{collector=\"balance\"} reads 0.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 21600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
