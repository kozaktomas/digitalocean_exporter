              "Value #B": 3,
              "Value #C": 4,
              "id": 5,
              "name": 0,
              "state": 2,
              "type": 1
            },
            "renameByName": {
              "Value #B": "Days remaining",
              "Value #C": "DNS names"
            }
          }
        }
