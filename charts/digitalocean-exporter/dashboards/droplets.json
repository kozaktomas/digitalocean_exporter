{
  "annotations": {
    "list": []
  },
  "description": "Droplet inventory plus the CPU, memory and disk figures DigitalOcean's monitoring API reports for them.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "digitalocean"
      ],
      "targetBlank": false,
      "title": "DigitalOcean",
      "tooltip": "Other DigitalOcean dashboards",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Inventory as DigitalOcean reports it. 'Price / month' is the list price of the size, which is what the droplet costs if it runs the whole month -- a powered-off droplet is still billed. Needs --collector.droplets.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Name"
              },
              {
                "id": "custom.width",
